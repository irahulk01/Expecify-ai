echo "Running Husky Pre-Commit Hooks..."

# 1. Line Count Check for Components (Limit: 200 lines)
echo "Checking line count for components..."
MAX_LINES=200
FAIL=0

# Find all .tsx and .ts files in components/ directory and count lines
FILES=$(find components -type f \( -name "*.tsx" -o -name "*.ts" \))

for file in $FILES; do
  lines=$(wc -l < "$file")
  if [ "$lines" -gt "$MAX_LINES" ]; then
    echo "❌ Error: $file exceeds $MAX_LINES lines (has $lines lines)."
    FAIL=1
  fi
done

if [ $FAIL -eq 1 ]; then
  echo "💥 Commit failed! Please break down components into smaller files (<200 lines)."
  exit 1
fi

echo "✅ All components are under $MAX_LINES lines."

# 2. Prettier Formatting Check
echo "Running Prettier check..."
npx prettier --check "components/**/*.{ts,tsx}" || {
  echo "💥 Commit failed! Code is not formatted properly. Run 'npm run format'."
  exit 1
}
echo "✅ Prettier check passed."

# 3. TypeScript Typecheck
echo "Running TypeScript check..."
npx tsc --noEmit || {
  echo "💥 Commit failed! TypeScript errors found."
  exit 1
}
echo "✅ TypeScript check passed."
