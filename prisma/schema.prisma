// Prisma schema — v5 stable

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  password            String
  name                String?
  phone               String?       @unique
  onboardingCompleted Boolean       @default(false)
  onboardingState     String?
  salaryDate          String?
  goal                String?       @default("0")
  createdAt           DateTime      @default(now())
  
  transactions   Transaction[]
  budgets        Budget[]
  goals          Goal[]
  bills          Bill[]
  accounts       Account[]
  debts          Debt[]
}

model Debt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  category        String   // "Loan" | "EMI" | "Credit Card"
  totalAmount     Float
  remainingAmount Float
  createdAt       DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  type      String   // "income" | "expense"
  category  String
  date      DateTime @default(now())
  note      String?
  accountId String?  // Linked payment method
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
}

model Bill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  dueDate     DateTime
  category    String   // "Utility" | "Rent" | "Subscription" | "EMI"
  status      String   @default("unpaid") // "paid" | "unpaid"
  icon        String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  icon          String?  // Lucide icon name
  category      String?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Account {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // "UPI (Primary)" | "Amex Gold" | "Cash"
  type      String   // "Bank" | "Credit" | "Wallet"
  balance   Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Budget {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  limit    Float
  month    Int
  year     Int

  @@unique([userId, category, month, year])
}
